@model TtaLesson11.Models.TtaEmployee

@{
    ViewData["Title"] = "Thêm mới nhân viên";
    Layout = "~/Views/Shared/_TtaLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <form asp-action="TtaCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="card">
                <div class="card-header">
                    <h2 class="my-2 text-center">@ViewData["Title"]</h2>
                </div>

                <div class="card-body">
                    <div class="form-group my-1">
                        <label asp-for="TtaEmpName" class="control-label"></label>
                        <input asp-for="TtaEmpName" class="form-control" />
                        <span asp-validation-for="TtaEmpName" class="text-danger"></span>
                    </div>

                    <div class="form-group my-1">
                        <label asp-for="TtaEmpLevel" class="control-label"></label>
                        <input asp-for="TtaEmpLevel" class="form-control" />
                        <span asp-validation-for="TtaEmpLevel" class="text-danger"></span>
                    </div>

                    <div class="form-group my-1">
                        <label asp-for="TtaEmpStartDate" class="control-label"></label>
                        <input asp-for="TtaEmpStartDate" class="form-control" type="date" />
                        <span asp-validation-for="TtaEmpStartDate" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="TtaEmpStatus" class="control-label"></label>
                        <input asp-for="TtaEmpStatus" class="form-control" />
                        <span asp-validation-for="TtaEmpStatus" class="text-danger"></span>
                    </div>

                </div>

                <div class="card-footer text-center">
                    <input type="submit" value="Thêm mới" class="btn btn-success mx-2" />
                    <a asp-action="TtaIndex" class="btn btn-secondary">Quay lại danh sách</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
