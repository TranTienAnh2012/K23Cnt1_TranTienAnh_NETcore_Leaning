@model TtaLesson11.Models.TtaEmployee

@{
    ViewData["Title"] = "Sửa thông tin nhân viên";
    Layout = "~/Views/Shared/_TtaLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <form asp-action="TtaEdit">
            <input type="hidden" asp-for="TtaEmpId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="card">
                <div class="card-header">
                    <h2 class="my-2 text-center">@ViewData["Title"]</h2>
                </div>
                <div class="card-body">
                    <div class="form-group my-1">
                        <label asp-for="TtaEmpName"></label>
                        <input asp-for="TtaEmpName" class="form-control" />
                        <span asp-validation-for="TtaEmpName" class="text-danger"></span>
                    </div>
                    <div class="form-group my-1">
                        <label asp-for="TtaEmpLevel"></label>
                        <input asp-for="TtaEmpLevel" class="form-control" />
                        <span asp-validation-for="TtaEmpLevel" class="text-danger"></span>
                    </div>
                    <div class="form-group my-1">
                        <label asp-for="TtaEmpStartDate"></label>
                        <input asp-for="TtaEmpStartDate" class="form-control" type="date" />
                        <span asp-validation-for="TtaEmpStartDate" class="text-danger"></span>
                    </div>
                    <div class="form-group my-1">
                        <label asp-for="TtaEmpStatus"></label>
                        <select asp-for="TtaEmpStatus" class="form-control">
                            <option value="true" selected="@(Model.TtaEmpStatus == true)">Show</option>
                            <option value="false" selected="@(Model.TtaEmpStatus == false)">Hide</option>
                        </select>
                        <span asp-validation-for="TtaEmpStatus" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer text-center">
                    <input type="submit" value="Lưu" class="btn btn-primary" />
                    <a asp-action="TtaIndex" class="btn btn-secondary">Quay lại</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
