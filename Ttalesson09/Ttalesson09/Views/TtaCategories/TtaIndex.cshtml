@model IEnumerable<Ttalesson09.Models.Category>

@{
    ViewData["Title"] = "Danh Sách Loại Sách";
    Layout = "~/Views/Shared/_TtaLayout.cshtml";
}

<h1 class="text-center">@ViewData["Title"]</h1>

<form asp-action="TtaIndex" method="get" class="mb-3">
    <div class="d-flex flex-row-reverse">
        <input type="text" name="keyword" class="form-control w-25 ms-2" placeholder="Tìm thể loại..." value="@Context.Request.Query["keyword"]" />
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>
</form>

<p>
    <a asp-action="TtaCreate" class="btn btn-success">Create New</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>STT</th> <!-- Hiển thị số thứ tự -->
            <th>@Html.DisplayNameFor(model => model.First().CategoryName)</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @{
            int stt = 1;
            foreach (var item in Model.OrderBy(c => c.CategoryId)) // đảm bảo sắp xếp tăng dần
            {
                <tr>
                    <td>@stt</td>
                    <td>@Html.DisplayFor(modelItem => item.CategoryName)</td>
                    <td class="text-center">
                        <a asp-action="TtaEdit" asp-route-TtaId="@item.CategoryId" class="btn btn-primary btn-sm">Edit</a>
                        <a asp-action="TtaDetails" asp-route-TtaId="@item.CategoryId" class="btn btn-info btn-sm">Details</a>
                        <a asp-action="TtaDelete" asp-route-TtaId="@item.CategoryId" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
                stt++;
            }
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3">Tổng số: @Model.Count()</th>
        </tr>
    </tfoot>
</table>
