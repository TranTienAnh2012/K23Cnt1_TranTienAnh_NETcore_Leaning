@model Ttalesson09.Models.Category

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_TtaLayout.cshtml";
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h1>@ViewData["Title"]</h1>
            </div>

            <div class="card-body">
                <div class="mb-3">

                    <label class="form-label fw-bold">@Html.DisplayNameFor(model => model.CategoryId)</label>
                    <div class="form-control">@Model.CategoryId</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">@Html.DisplayNameFor(model => model.CategoryName)</label>
                    <div class="form-control">@Model.CategoryName</div>
                </div>
            </div>

            <div class="card-footer">
                <a asp-action="TtaEdit" asp-route-TtaId="@Model?.CategoryId" class="btn btn-primary">Edit</a>
                <a asp-action="TtaIndex" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>
