@model Ttalesson09.Models.Category

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_TtaLayout.cshtml";
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="TtaDelete">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h2>@ViewData["Title"]</h2>
                    <p>Bạn có chắc chắn muốn xóa thể loại này không?</p>
                </div>

                <div class="card-body">
                    <input type="hidden" asp-for="CategoryId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">@Html.DisplayNameFor(model => model.CategoryId)</label>
                        <div class="form-control">@Model.CategoryId</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">@Html.DisplayNameFor(model => model.CategoryName)</label>
                        <div class="form-control">@Model.CategoryName</div>
                    </div>
                </div>

                <div class="card-footer">
                    <input type="submit" value="Xóa" class="btn btn-danger" />
                    <a asp-action="TtaIndex" class="btn btn-secondary">Quay Lại</a>
                </div>
            </div>
        </form>
    </div>
</div>
