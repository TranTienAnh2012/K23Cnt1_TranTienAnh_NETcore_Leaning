@model Ttalesson09.Models.Publisher

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_TtaLayout.cshtml";
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="TtaDelete" method="post">
            <div class="card">
                <div class="card-header">
                    <h1>@ViewData["Title"]</h1>
                </div>

                <div class="card-body">
                    <h3 class="text-danger">Are you sure you want to delete this?</h3>

                    <div class="form-group my-1">
                        <label class="control-label">@Html.DisplayNameFor(model => model.PublisherName)</label>
                        <div class="form-control-plaintext">
                            @Html.DisplayFor(model => model.PublisherName)
                        </div>
                    </div>

                    <div class="form-group my-1">
                        <label class="control-label">@Html.DisplayNameFor(model => model.Phone)</label>
                        <div class="form-control-plaintext">
                            @Html.DisplayFor(model => model.Phone)
                        </div>
                    </div>

                    <div class="form-group my-1">
                        <label class="control-label">@Html.DisplayNameFor(model => model.Address)</label>
                        <div class="form-control-plaintext">
                            @Html.DisplayFor(model => model.Address)
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <input type="hidden" asp-for="PublisherId" />
                    <input type="submit" value="Delete" class="btn btn-danger" />
                    <a asp-action="TtaIndex" class="btn btn-secondary ms-2">Back to List</a>
                </div>
            </div>
        </form>
    </div>
</div>
