@model IEnumerable<Ttalesson09.Models.Publisher>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_TtaLayout.cshtml";
}

<h1>Index</h1>

<form asp-action="TtaIndex" method="get" class="mb-3">
    <div class="d-flex flex-row-reverse">
        <input type="text" name="keywordPub" class="form-control w-25 ms-2" placeholder="Tìm thể loại..." value="@Context.Request.Query["keywordPub"]" />
        <button type="submit" class="btn btn-primary btn-sm">Tìm kiếm</button>
    </div>
</form>
<p>
    <a asp-action="TtaCreate" class="btn btn-success btn-sm">Create New</a>
</p>
<table class="table  table-bordered table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PublisherName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th class="text-center"> Hoat Dong</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PublisherName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td class="text-center">
                    <a asp-action="TtaEdit" asp-route-TtaId="@item.PublisherId" class="btn btn-primary btn-sm" >Edit</a>
                    <a asp-action="TtaDetails" asp-route-TtaId="@item.PublisherId" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="TtaDelete" asp-route-TtaId="@item.PublisherId" class="btn btn-warning btn-sm">Delete</a>
            </td>
        </tr>
}
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3">Tổng số: @Model.Count()</th>
        </tr>
    </tfoot>
</table>
