@model IEnumerable<DemoBaiThi.Models.Category>

@{
    ViewData["Title"] = " Danh Sách Loại Sách";
    Layout = "~/Views/Shared/_TtaLayout.cshtml";
}

<h2 class="text-center text-primary mb-4">
    <i class="fas fa-book me-2"></i>@ViewData["Title"]
</h2>

<form asp-action="TtaIndex" method="get" class="mb-4">
    <div class="d-flex justify-content-end gap-2">
        <input type="text" name="keyword" class="form-control w-25" placeholder="🔍 Tìm thể loại..." value="@Context.Request.Query["keyword"]" />
        <button type="submit" class="btn btn-outline-primary">
            <i class="fas fa-search me-1"></i> Tìm kiếm
        </button>
    </div>
</form>

<p>
    <a asp-action="TtaCreate" class="btn btn-success">
        <i class="fas fa-plus-circle me-1"></i> Thêm Mới
    </a>
</p>

<table class="table table-bordered table-hover shadow-sm">
    <thead class="table-primary text-center">
        <tr>
            <th>STT</th>
            <th><i class="fas fa-id-badge me-1"></i> Mã Loại</th>
            <th><i class="fas fa-tag me-1"></i> Tên Loại</th>
            <th><i class="fas fa-cogs me-1"></i> Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @{
            int stt = 1;
            foreach (var item in Model.OrderBy(c => c.CategoryId))
            {
                <tr>
                    <td class="text-center">@stt</td>
                    <td class="text-center">@Html.DisplayFor(modelItem => item.CategoryId)</td>
                    <td>@Html.DisplayFor(modelItem => item.CategoryName)</td>
                    <td class="text-center">
                        <a asp-action="TtaEdit" asp-route-TtaId="@item.CategoryId" class="btn btn-sm btn-primary me-1">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a asp-action="TtaDetails" asp-route-TtaId="@item.CategoryId" class="btn btn-sm btn-info text-white me-1">
                            <i class="fas fa-info-circle"></i>
                        </a>
                        <a asp-action="TtaDelete" asp-route-TtaId="@item.CategoryId" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash-alt"></i>
                        </a>
                    </td>
                </tr>
                stt++;
            }
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="4" class="text-end">Tổng số: @Model.Count()</th>
        </tr>
    </tfoot>
</table>
