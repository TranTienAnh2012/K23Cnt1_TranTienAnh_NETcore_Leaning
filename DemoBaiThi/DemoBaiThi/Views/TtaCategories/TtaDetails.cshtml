@model DemoBaiThi.Models.Category

@{
    ViewData["Title"] = "Chi Tiết Loại Sách";
    Layout = "~/Views/Shared/_TtaLayout.cshtml";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow rounded-4">
            <div class="card-header bg-info text-white text-center rounded-top-4">
                <h4><i class="fas fa-info-circle me-2"></i>@ViewData["Title"]</h4>
            </div>

            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary">
                        <i class="fas fa-id-badge me-1"></i> @Html.DisplayNameFor(model => model.CategoryId)
                    </label>
                    <div class="form-control bg-light">@Model.CategoryId</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary">
                        <i class="fas fa-tag me-1"></i> @Html.DisplayNameFor(model => model.CategoryName)
                    </label>
                    <div class="form-control bg-light">@Model.CategoryName</div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a asp-action="TtaEdit" asp-route-TtaId="@Model?.CategoryId" class="btn btn-warning">
                    <i class="fas fa-edit me-1"></i> Chỉnh sửa
                </a>
                <a asp-action="TtaIndex" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại
                </a>
            </div>
        </div>
    </div>
</div>
