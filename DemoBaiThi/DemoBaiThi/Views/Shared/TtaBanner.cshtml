@* TtaBanner.cshtml *@
<div id="ttaCarousel" class="carousel slide tta-carousel" data-bs-ride="carousel" data-bs-interval="5000">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#ttaCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#ttaCarousel" data-bs-slide-to="1"></button>
    </div>

    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="@Url.Content("~/img/ImgBaner/03.jpg")" class="d-block w-100 tta-carousel-image" alt="Slide 1">
            <div class="carousel-caption tta-caption">
                <h5>📘 Thư viện Sách số</h5>
                <p>Nơi chia sẻ tri thức và kết nối đam mê đọc sách</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="@Url.Content("~/img/ImgBaner/04.jpg")" class="d-block w-100 tta-carousel-image" alt="Slide 2">
            <div class="carousel-caption tta-caption">
                <h5>🎓 Trường Đại học Nguyễn Trãi</h5>
                <p>Chào mừng bạn đến với Website Demo</p>
            </div>
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#ttaCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#ttaCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>
