@model List<Ttalesson06.Models.TtaEmployee>

@{
    ViewData["Title"] = "Danh Sách Học Viên";
}

<h2>@ViewData["Title"]</h2>

<table class="table table-striped table-bordered  table-hover">
    <thead class="table-primary">
        <tr>
            <th>ID</th>
            <th>Họ và Tên</th>
            <th>Ngày Sinh</th>
            <th>Email</th>
            <th>Điện Thoại</th>
            <th>Học Phí (VNĐ)</th>
            <th>Trạng Thái</th>
            <th>Chi Tiết</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td>@emp.TtaId</td>
                <td>@emp.TtaName</td>
                <td>@emp.TtaBirthDay.ToString("dd/MM/yyyy")</td>
                <td>@emp.TtaEmail</td>
                <td>@emp.TtaPhone</td>
                <td>@emp.TtaSalary.ToString("N0")</td>
                <td>
                    @if (emp.TtaStatus == 1)
                    {
                        <span class="badge bg-success">Đang học</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Đã nghỉ</span>
                    }
                </td>

                <td>
                    <a asp-action="GetEmployee" asp-route-id="@emp.TtaId" class="btn btn-info btn-sm">Xem</a>
                </td>
            </tr>
        }
    </tbody>
</table>
