@model Ttalesson06.Models.TtaEmployee

@{
    ViewData["Title"] = "Tạo Mới Học Viên";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="TtaCreate" method="post">
    <div class="form-group mb-3">
        <label asp-for="TtaName" class="form-label"></label>
        <input asp-for="TtaName" class="form-control" />
        <span asp-validation-for="TtaName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="TtaBirthDay" class="form-label"></label>
        <input asp-for="TtaBirthDay" type="date" class="form-control" />
        <span asp-validation-for="TtaBirthDay" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="TtaEmail" class="form-label"></label>
        <input asp-for="TtaEmail" class="form-control" type="email" />
        <span asp-validation-for="TtaEmail" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="TtaPhone" class="form-label"></label>
        <input asp-for="TtaPhone" class="form-control" />
        <span asp-validation-for="TtaPhone" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="TtaSalary" class="form-label"></label>
        <input asp-for="TtaSalary" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="TtaSalary" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="TtaStatus" class="form-label"></label>
        <select asp-for="TtaStatus" class="form-select">
            <option value="1">Đang học</option>
            <option value="0">Đã nghỉ</option>
        </select>
        <span asp-validation-for="TtaStatus" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="TtaIndex" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
