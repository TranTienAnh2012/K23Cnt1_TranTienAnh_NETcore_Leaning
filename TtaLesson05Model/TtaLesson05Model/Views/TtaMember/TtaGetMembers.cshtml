@{
    ViewData["Title"] = "TtaGetMembers";
    var member = ViewBag.member as TtaLesson05Model.Models.Datamodle.TtaMember;
}



<div class="container mt-5">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0"><i class="fas fa-users"></i> Danh sách thành viên</h3>
        </div>
        <div class="card-body">
            <table class="table table-hover table-bordered align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Mã sinh viên</th>
                        <th>Username</th>
                        <th>Họ và tên</th>
                        <th>Password</th>
                        <th>Email</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        foreach (var item in ViewBag.members)
                        {
                            <tr>
                                <td>@index</td>
                                <td>@item.TtaMemberId</td>
                                <td>@item.TtaUsersName</td>
                                <td>@item.TtaFullName</td>
                                <td>@item.TtaPassword</td>
                                <td>@item.TtaEmail</td>
                                <td>
                                    <button class="btn btn-sm btn-warning"><i class="fas fa-edit"></i> Sửa</button>
                                    <button class="btn btn-sm btn-danger"><i class="fas fa-trash-alt"></i> Xóa</button>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
