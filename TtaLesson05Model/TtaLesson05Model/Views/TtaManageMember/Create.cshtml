@model TtaLesson05Model.Models.Datamodle.TtaMember

@{
    ViewData["Title"] = "Thêm mới thành viên";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="TtaUsersName"></label>
        <input asp-for="TtaUsersName" class="form-control" />
        <span asp-validation-for="TtaUsersName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TtaFullName"></label>
        <input asp-for="TtaFullName" class="form-control" />
        <span asp-validation-for="TtaFullName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TtaPassword"></label>
        <input asp-for="TtaPassword" class="form-control" />
        <span asp-validation-for="TtaPassword" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TtaEmail"></label>
        <input asp-for="TtaEmail" class="form-control" />
        <span asp-validation-for="TtaEmail" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
