@if (ViewBag.member02 != null)
{
    <table class="table table-hover">
        <tr>
            <th>Mã sinh viên</th>
            <th>Username</th>
            <th>Họ và tên</th>
            <th>Password</th>
            <th>Email</th>
        </tr>
        @foreach (var m in ViewBag.member02)
        {
            <tr>
                <td>@m.TtaMemberId</td>
                <td>@m.TtaUsersName</td>
                <td>@m.TtaFullName</td>
                <td>@m.TtaPassword</td>
                <td>@m.TtaEmail</td>
            </tr>
        }
    </table>
}
else
{
    <p>Không có dữ liệu để hiển thị.</p>
}
